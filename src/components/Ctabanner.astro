---
interface Props {
    backgroundImage: string;
    heading: string;
}
const { backgroundImage, heading } = Astro.props;
---

<section
    class="cta-banner"
    style={`background-image:url('${backgroundImage}')`}
>
    <div class="cta-banner__overlay">
        <div class="cta-banner__content">
            <h3>{heading}</h3>
            <p><slot /></p>
            <slot name="cta" />
        </div>
    </div>
</section>

<style>
    .cta-banner {
        position: relative;
        min-height: 50vh;
        width: 100vw;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    }

    .cta-banner__overlay {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 50vh;
        padding: 15px;
        background: rgba(0, 0, 0, 0.8);
    }

    .cta-banner__content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 1000px;
        color: var(--color-cream);
        font-style: italic;
        text-align: center;
    }

    .cta-banner__content h3 {
        font-size: calc(2.2vw + 2rem);
    }

    .cta-banner__content p {
        max-width: 1000px;
        margin-bottom: 50px;
        font-size: calc(1vw + 1rem);
        line-height: calc(2vw + 1rem);
    }

    @media (min-width: 1024px) {
        .cta-banner__content {
            display: block;
            text-align: left;
        }
    }
</style>
