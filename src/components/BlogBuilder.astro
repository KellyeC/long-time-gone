---
import InstagramEmbed from "./InstagramEmbed.astro";

interface Props {
    title?: string;
    IGSrc?: string;
    IGEmbed?: string;
    mediaSrc?: string;
    mediaAlt?: string;
    content?: string;
    layout?: "float";
}
const { title, IGSrc, IGEmbed, mediaSrc, mediaAlt, content, layout } =
    Astro.props;
const hasTextPanel = Boolean(content) || (Boolean(IGSrc) && !IGEmbed);
---

<section class="post">
    <div class="post_title">
        {title && <p style="text-decoration: underline;">{title}</p>}
        {title && <p>- Posted on: {new Date().toLocaleDateString()}</p>}
    </div>
    <div
        class:list={[
            "post_content",
            { "post_content--centered": !hasTextPanel },
            { "post_content--float": layout === "float" },
        ]}
    >
        <div class="post__media">
            {
                IGEmbed ? (
                    <InstagramEmbed url={IGEmbed} />
                ) : mediaSrc ? (
                    <img
                        src={mediaSrc}
                        alt={mediaAlt ?? ""}
                        class="post__img"
                    />
                ) : null
            }
        </div>
        {
            hasTextPanel && (
                <div class="post__text">
                    {content && <p>{content}</p>}
                    {!IGEmbed && IGSrc && (
                        <a
                            class="post_link"
                            href={IGSrc}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            View this blog post on Instagram
                        </a>
                    )}
                </div>
            )
        }
    </div>

    {
        !IGEmbed && mediaSrc && (
            <div class="post__lightbox" hidden>
                <img src={mediaSrc} alt={mediaAlt ?? ""} />
            </div>
        )
    }
</section>

<style>
    .post {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 50px 15px;
        background-color: var(--color-cream);
        position: relative;
    }

    .post_title {
        display: flex;
        flex-direction: row;
        align-items: baseline;
        text-align: center;
        margin-bottom: 15px;
    }

    .post_title p:first-child {
        margin-right: 10px;
    }

    .post_content {
        display: flex;
        flex-direction: row;
        width: 100%;
    }

    .post_content--centered {
        justify-content: center;
    }

    .post_content--centered .post__media {
        width: auto;
        max-width: 540px;
    }

    .post_content--float {
        display: flow-root;
    }

    .post_content--float .post__media {
        float: left;
        width: 50%;
        height: 350px;
        box-sizing: border-box;
        padding-right: 20px;
        margin: 0 0 15px 0;
    }

    .post_content--float .post__text {
        display: block;
        margin: 0;
        padding: 0;
    }

    .post__media {
        width: 50%;
        max-width: 1000px;
        height: 500px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

    .post__media :global(.instagram-media) {
        max-height: 500px;
        overflow-y: auto;
    }

    .post__img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: top;
        cursor: pointer;
    }

    .post__text {
        text-align: left;
        margin-left: 10px;
        padding: 20px;
        align-self: flex-start;
    }

    .post__text p {
        font-size: calc(1vw + 0.5rem);
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .post__text a {
        font-size: calc(0.8vw + 0.8rem);
        color: var(--color-terracotta);
        text-decoration: none;
    }

    /* Lightbox */
    .post__lightbox {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.85);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 20px;
        cursor: zoom-out;
    }

    .post__lightbox:not([hidden]) {
        display: flex;
    }

    .post__lightbox img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    @media (max-width: 768px) {
        .post_content {
            flex-direction: column;
        }

        .post__media {
            width: 100%;
            height: 350px;
        }

        .post_content--centered .post__media {
            width: 100%;
            max-width: 400px;
        }

        .post_content--float .post__media {
            float: none;
            width: 100%;
            height: 350px;
            margin: 0 0 15px 0;
        }

        .post__text {
            margin-left: 0;
            margin-top: 15px;
            text-align: center;
        }

        .post__text p {
            font-size: 1rem;
        }

        .post__text a {
            font-size: 0.95rem;
        }
    }
</style>

<script>
    document.querySelectorAll<HTMLElement>(".post").forEach((post) => {
        const img = post.querySelector<HTMLImageElement>(".post__img");
        const lightbox = post.querySelector<HTMLElement>(".post__lightbox");

        if (!img || !lightbox) return;

        img.addEventListener("click", () => {
            lightbox.hidden = false;
        });

        lightbox.addEventListener("click", () => {
            lightbox.hidden = true;
        });
    });
</script>
