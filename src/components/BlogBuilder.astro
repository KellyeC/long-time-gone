---
interface props {
    title: string;
    IGSrc: string;
    mediaSrc: string;
    content: string;
}
const { title, IGSrc, mediaSrc, content } = Astro.props;
---

<section class="post">
    <div class="post_title">
        <h2>{title}</h2>
        <p>- Posted on: {new Date().toLocaleDateString()}</p>
    </div>
    <div class="post_content">
        <div class="post__media">
            <img src={mediaSrc} alt="Blog Media" />
        </div>
        <div class="post__text">
            <p>{content}</p>
            <a
                class="post_link"
                href={IGSrc}
                target="_blank"
                rel="noopener noreferrer">View this blog post on Instagram</a
            >
        </div>
    </div>
</section>

<style>
    .post {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 1000px;
        margin: 0 auto;
        padding: 50px 15px;
        background-color: var(--color-cream);
    }

    .post_title {
        display: flex;
        flex-direction: row;
        text-align: center;
        margin-bottom: 15px;
    }

    .post_title h2 {
        margin-right: 10px;
    }

    .post_content {
        display: flex;
        flex-direction: row;
    }
    .post__media {
        width: 50%;
        max-width: 1000px;
    }

    .post__media img {
        width: 100%;
        height: auto;
    }

    .post__text {
        text-align: left;
        margin-left: 10px;
    }

    .post__text p {
        font-size: calc(1vw + 0.5rem);
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .post__text a {
        font-size: calc(0.8vw + 0.8rem);
        color: var(--color-terracotta);
        text-decoration: none;
    }
</style>
