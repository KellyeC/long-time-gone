---
const navLinks = [
    { href: "/", label: "Home" },
    { href: "/about", label: "About" },
    { href: "/bespoke", label: "Bespoke" },
    { href: "/blog", label: "Blog" },
    { href: "https://longtimegone.bigcartel.com", label: "Shop" },
    { href: "/contact", label: "Contact" },
];
---

<header class="site-header">
    <div class="site-header__inner">
        <div class="site-header__left">
            <button
                type="button"
                class="hamburger"
                id="menuOpen"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="sidebarNav"
            >
                <svg
                    viewBox="0 0 100 80"
                    width="30"
                    height="30"
                    aria-hidden="true"
                    focusable="false"
                >
                    <rect width="100" height="15" rx="8"></rect>
                    <rect y="30" width="100" height="15" rx="8"></rect>
                    <rect y="60" width="100" height="15" rx="8"></rect>
                </svg>
            </button>
        </div>

        <div class="site-header__middle">
            <a href="/" aria-current="page">Long Time Gone</a>
        </div>

        <div class="site-header__right">
            <a
                class="site-header__shop-link"
                href="https://longtimegone.bigcartel.com"
                target="_blank"
                rel="noopener noreferrer">Shop</a
            >
        </div>
    </div>
</header>

<nav class="sidebar-nav" id="sidebarNav" aria-hidden="true">
    <button
        type="button"
        class="sidebar-nav__close"
        id="menuClose"
        aria-label="Close menu"
    >
        <svg
            width="32"
            height="32"
            viewBox="0 0 44 44"
            aria-hidden="true"
            focusable="false"
        >
            <path
                d="M0.549989 4.44999L4.44999 0.549988L43.45 39.55L39.55 43.45L0.549989 4.44999Z"
                fill="#fffbf4"></path>
            <path
                d="M39.55 0.549988L43.45 4.44999L4.44999 43.45L0.549988 39.55L39.55 0.549988Z"
                fill="#fffbf4"></path>
        </svg>
    </button>
    <ul class="sidebar-nav__links">
        {
            navLinks.map((link) => (
                <li>
                    <a href={link.href}>{link.label}</a>
                </li>
            ))
        }
    </ul>
</nav>
<div class="sidebar-overlay" id="sidebarOverlay" hidden></div>

<script>
    const openBtn = document.getElementById("menuOpen");
    const closeBtn = document.getElementById("menuClose");
    const sidebar = document.getElementById("sidebarNav");
    const overlay = document.getElementById("sidebarOverlay");

    function openNav() {
        sidebar?.classList.add("is-open");
        sidebar?.setAttribute("aria-hidden", "false");
        if (overlay) overlay.hidden = false;
        openBtn?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
    }

    function closeNav() {
        sidebar?.classList.remove("is-open");
        sidebar?.setAttribute("aria-hidden", "true");
        if (overlay) overlay.hidden = true;
        openBtn?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
    }

    openBtn?.addEventListener("click", openNav);
    closeBtn?.addEventListener("click", closeNav);
    overlay?.addEventListener("click", closeNav);

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeNav();
    });
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        height: 100px;
        background: var(--color-cream);
    }

    .site-header__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        width: 100vw;
        height: 100%;
        max-width: var(--content-max);
        margin: 0 auto;
    }

    .site-header__left {
        display: flex;
        justify-content: flex-start;
        width: 30%;
        padding-left: 20px;
    }

    .site-header__middle {
        display: flex;
        justify-content: center;
        width: 40%;
    }

    .site-header__middle a {
        margin: 0;
        color: var(--color-ink);
        font-size: 1.8rem;
        font-weight: 700;
        font-style: italic;
        text-align: center;
    }

    .site-header__right {
        width: 30%;
        padding-right: 20px;
        display: flex;
        justify-content: flex-end;
    }

    .site-header__shop-link {
        transition:
            background 0.2s linear,
            border 0.2s linear;
        border: 1px solid #000000;
        background: transparent;
        color: #000000;
        height: auto;
        display: inline-flex;
        padding: 16px 32px;
        width: auto;
    }

    .site-header__shop-link:hover {
        border: 1px solid #ff5400;
        background: #ff5400;
        color: #ffffff;
    }

    @media (max-width: 425px) {
        .site-header__shop-link {
            display: none;
        }
    }

    @media (min-width: 1024px) {
        .site-header__middle a {
            font-size: 2.2rem;
        }
    }

    .hamburger {
        height: 40px;
        padding: 0;
        background: transparent;
        border: none;
        color: var(--color-ink);
    }

    .sidebar-nav {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 65vw;
        margin: 0;
        padding: 40px;
        background: var(--color-terracotta);
        z-index: 11;
        box-shadow:
            0 1px 1px rgba(0, 0, 0, 0.2),
            0 2px 2px rgba(0, 0, 0, 0.2),
            0 4px 4px rgba(0, 0, 0, 0.2),
            0 8px 8px rgba(0, 0, 0, 0.2),
            0 16px 16px rgba(0, 0, 0, 0.2),
            0 32px 32px rgba(0, 0, 0, 0.2);
        transform: translateX(-102%) translateZ(0);
        transition: transform 0.3s ease;
    }

    .sidebar-nav.is-open {
        transform: translateX(0) translateZ(0);
    }

    @media (min-width: 1024px) {
        .sidebar-nav {
            max-width: 700px;
            width: 50%;
        }
    }

    .sidebar-nav__close {
        position: absolute;
        top: 20px;
        right: 20px;
        height: 44px;
        padding: 0;
        background: transparent;
        border: none;
    }

    .sidebar-nav__links {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 1.5rem;
        font-style: italic;
    }

    .sidebar-nav__links li {
        margin: 20px 0 0;
    }

    .sidebar-nav__links a {
        padding: 0;
        color: var(--color-cream);
        border-bottom: 2px solid transparent;
        transition: 0.3s ease border;
    }

    .sidebar-nav__links a:hover {
        border-bottom: 2px solid var(--color-cream);
    }

    @media (min-width: 768px) {
        .sidebar-nav__links {
            font-size: 2rem;
        }

        .sidebar-nav__links li {
            margin: 40px 0 0;
        }
    }

    .sidebar-overlay {
        position: fixed;
        inset: 0;
        z-index: 10;
        background: rgba(0, 0, 0, 0.4);
    }

    .sidebar-overlay[hidden] {
        display: none;
    }
</style>
