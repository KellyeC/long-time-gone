---
interface Props {
    /** Full URL of the Instagram post/reel, e.g. https://www.instagram.com/reel/DYcgSRMs8_w/ */
    url: string;
    /** Optional caption text shown under the "View this post" link. Falls back to a generic caption. */
    caption?: string;
    /** Optional max-width in px for the embed card (Instagram's own default is 540). */
    maxWidth?: number;
}

const {
    url,
    caption = "View this post on Instagram",
    maxWidth = 540,
} = Astro.props;

// Instagram ignores query params on the permalink itself, so keep the url as-is;
// we just append the tracking params it normally uses for the embed link.
const permalink = url.replace(/\/?$/, "/"); // ensure trailing slash
const embedLink = `${permalink}?utm_source=ig_embed&utm_campaign=loading`;
---

<blockquote
    class="instagram-media"
    data-instgrm-permalink={embedLink}
    data-instgrm-version="14"
    style={`background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:1px; max-width:${maxWidth}px; min-width:326px; padding:0; width:99.375%; width:calc(100% - 2px);`}
>
    <div style="padding:16px;">
        <a
            href={embedLink}
            style="background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%; display:block;"
            target="_blank"
            rel="noopener noreferrer"
        >
            <div
                style="color:#3897f0; font-family:Arial,sans-serif; font-size:14px; font-weight:550; line-height:18px; padding:8px 0;"
            >
                View this post on Instagram
            </div>
        </a>
        <p
            style="color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; line-height:17px; margin-bottom:0; margin-top:8px; overflow:hidden; padding:8px 0 7px; text-align:center; text-overflow:ellipsis; white-space:nowrap;"
        >
            <a
                href={embedLink}
                style="color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; font-weight:normal; line-height:17px; text-decoration:none;"
                target="_blank"
                rel="noopener noreferrer">{caption}</a
            >
        </p>
    </div>
</blockquote>

<script is:inline async src="//www.instagram.com/embed.js"></script>

<script>
    // Instagram's embed.js only scans the DOM once, on its own load.
    // If embeds are added/re-rendered later (e.g. Astro client-side nav,
    // or multiple blockquotes present when the script is already cached),
    // re-trigger processing so every blockquote gets converted.
    function processInstagramEmbeds() {
        // @ts-ignore - instgrm is injected globally by Instagram's embed.js
        if (window.instgrm) {
            // @ts-ignore
            window.instgrm.Embeds.process();
        }
    }

    if (document.readyState === "complete") {
        processInstagramEmbeds();
    } else {
        window.addEventListener("load", processInstagramEmbeds);
    }

    document.addEventListener("astro:page-load", processInstagramEmbeds);
</script>
