---
interface Props {
    heading: string;
}

const { heading } = Astro.props;
---

<section class="paragraph">
    <h2>{heading}</h2>
    <p><slot /></p>
</section>

<style>
    .paragraph {
        width: 100%;
        max-width: var(--content-max);
        margin: 0 auto;
        padding: 15px 40px;
        text-align: center;
    }

    .paragraph h2 {
        font-size: 1.5rem;
        margin: 0 0 5px;
        color: var(--color-ink);
        line-height: calc(8vw + 2rem);
        font-style: italic;
        font-weight: 300;
    }

    .paragraph p {
        max-width: 100%;
        margin: 0;
        font-size: calc(1vw + 0.5rem);
        line-height: calc(2vw + 0.5rem);
    }

    /* @media (min-width: 768px) {
        .paragraph h2 {
            font-size: 2.5rem;
        }

        .paragraph p {
            max-width: 50%;
        }
    } */
</style>
