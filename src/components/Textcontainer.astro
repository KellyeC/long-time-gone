---
interface Props {
    heading: string;
    image: string;
    imageAlt: string;
    imageUrl: string;
}

const { heading } = Astro.props;
---

<section class="paragraph">
    <h2>{heading}</h2>
    <a href={Astro.props.imageUrl} target="_blank"
        ><img
            id="text_image"
            src={Astro.props.image}
            alt={Astro.props.imageAlt}
        /></a
    >
    <p><slot /></p>
</section>

<style>
    .paragraph {
        width: 100%;
        max-width: var(--content-max);
        margin: 0 auto;
        padding: 15px 40px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .paragraph h2 {
        /* font-size: 1.5rem; */
        margin: 0 0 5px;
        color: var(--color-ink);
        font-size: calc(1vw + 1.5rem);
        line-height: calc(8vw + 2rem);
        font-style: italic;
        font-weight: 300;
    }

    .paragraph p {
        max-width: 100%;
        margin: 0;
        font-size: calc(1vw + 0.5rem);
        line-height: calc(2vw + 0.5rem);
    }

    #text_image {
        width: 100%;
        max-width: 400px;
        height: auto;
        margin-bottom: 20px;
    }

    /* @media (min-width: 768px) {
        .paragraph h2 {
            font-size: 2.5rem;
        }

        .paragraph p {
            max-width: 50%;
        }
    } */
</style>
