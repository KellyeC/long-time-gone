---
interface Props {
    src: string;
    alt: string;
}
const { src, alt } = Astro.props;
---

<div class="hero">
    <img class="hero__image" src={src} alt={alt} loading="eager" />
</div>

<style>
    .hero {
        position: relative;
        height: 100vh;
        overflow: hidden;
    }

    .hero__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }
</style>
