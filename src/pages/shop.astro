---
import Layout from "../layouts/Layout.astro";
import Textcontainer from "../components/Textcontainer.astro";
---

<Layout title="Shop">
    <Textcontainer heading="Custom Chainstitch Embroidery">
        <p>
            <paypal-add-to-cart-button data-id="X3JCRWG8TB82C"
            ></paypal-add-to-cart-button>
            <script>
                cartPaypal.AddToCart({ id: "X3JCRWG8TB82C" });
            </script>
        </p>
    </Textcontainer>
    <paypal-cart-button data-id="pp-view-cart" style="align-self:center;"
    ></paypal-cart-button>
    <script>
        cartPaypal.Cart({ id: "pp-view-cart" });
    </script>
</Layout>
