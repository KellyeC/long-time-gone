---
import Layout from "../layouts/Layout.astro";
import BlogBuilder from "../components/BlogBuilder.astro";
interface Post {
    title?: string;
    IGSrc?: string;
    IGEmbed?: string;
    mediaSrc?: string;
    mediaAlt?: string;
    content?: string;
}

const posts: Post[] = [
    // {
    //     title: "TEXT WRITTEN HERE WILL DISPLAY A TITLE FOLLOWED BY A DATE",
    //     IGSrc: "AN IG POST URL HERE WILL LINK TO IG",
