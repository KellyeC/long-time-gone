---
import Layout from "../layouts/Layout.astro";
import BlogBuilder from "../components/BlogBuilder.astro";
interface Post {
    title?: string;
    IGSrc?: string;
    IGEmbed?: string;
    mediaSrc?: string;
    mediaAlt?: string;
    content?: string;
    layout?: "float";
}

const posts: Post[] = [
    // {
    //     title: "TEXT WRITTEN HERE WILL DISPLAY A TITLE FOLLOWED BY A DATE",
    //     IGSrc: "AN IG POST URL HERE WILL LINK TO IG",
    //     IGEmbed: "AN IG POST URL HERE WILL EMBED AN INSTAGRAM POST (I RECOMMEND YOU USE THIS ONE ON IT'S OWN.",
    //     mediaSrc: "A LINK TO AN IMAGE YOU HAVE ON THE WEBSITE.. E.G. - /images/whatever.ext",
    //     mediaAlt: "TEXT THAT APPEARS WHEN YOU HOVER OVER THE IMAGE - FOR ACCESSIBILITY PURPOSES.",
    //     content: "The text that appears next to image."
    // },
    {
        title: "Creative Stories in the Studio",
        mediaSrc: "/images/KellyeDanSuitScan.png",
        mediaAlt: "Kellye Coffyn",
        layout: "float",
        content:
            "Creative Stories came to visit and ask me some questions about my practice and art/creativity in general. Watch the teaser for the documentary here ",
        IGSrc: "https://www.instagram.com/reel/DYcgSRMs8_w/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==",
    },
 
    {
        IGEmbed:
            "https://www.instagram.com/reel/DYcgSRMs8_w/?utm_source=ig_web_copy_link&igsh=MzRlODBiNWFlZA==",
    },
    {
        IGEmbed:
            "https://www.instagram.com/p/C9KNdgRsBJZ/?stkn=MzRlODBiNWFlZA==",
    },
];
---

<Layout title="Blog">
    <main>
        {posts.map((post) => <BlogBuilder {...post} />)}
    </main>
</Layout>
