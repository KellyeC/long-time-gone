---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import IntroHeading from "../components/Introheading.astro";
import ImageBand from "../components/Imageband.astro";
import TextImageSplit from "../components/Textimagesplit.astro";
import CtaBanner from "../components/Ctabanner.astro";
---

<Layout title="Home">
    <Hero src="/images/railTim.jpg" alt="Clothing rail in Kellye's studio" />

    <IntroHeading heading="Bespoke Tailor for Fancy Cowboys (of all genders)">
        Hand-Steered Chainstich and Irish embroidery.<br /><br />
        Former Tailor and Embroiderer for the 'Rhinestone Rembrandt', Manuel Cuevas
        <br /><br />
        Born and Bred Texan, handmade in Leeds
    </IntroHeading>

    <ImageBand src="/images/KSCbigHairHandPressBWDan.jpg" alt="KellyeSue Coffyn in her studio, phot by Dan Dummer" imageUrl="https://www.dsdphoto.co.uk"/>
    <CtaBanner backgroundImage="/images/KSCLightSpaceDummyShearsTapeBWDanCrop.jpg" heading="Who TF is LongTimeGone?">
    Learn more about Cowboy tailor KellyeSue Coffyn 
    <a class="btn" href="/about" slot="cta">About</a>

    </CtaBanner>
    <TextImageSplit
        imageSrc="/images/JacketInnardsBWDan.jpg"
        imageAlt="A bespoke tailored jacket in progress"
    >
        Want to know more about the process used to make fully bespoke garments and Western
        accessories?
        <a class="btn" href="/bespoke" slot="cta">Start Here</a>
    </TextImageSplit>

    <CtaBanner backgroundImage="/images/LTGPegboardColourMediumFormatDan.jpg" heading="Bespoke">
        From full rhinestoned Western Wear suits made especially for you to
        Savile Row standards or a custom embroidered denim jacket, let me make
        you the garment of your dreams.
     

    

    </CtaBanner>
</Layout>
