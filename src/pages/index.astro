---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import IntroHeading from "../components/Introheading.astro";
import ImageBand from "../components/Imageband.astro";
import TextImageSplit from "../components/TextImageSplit.astro";
import CtaBanner from "../components/Ctabanner.astro";
---

<Layout title="Home">
    <Hero src="/images/scene1.webp" alt="Chainstitch Yorkshire Scene" />

    <IntroHeading heading="Custom Chainstitch Embroidery.">
        Wearable art pieces and accessories.<br /><br />
        Embroidered using traditional chainstich techniques.<br /><br />
        From the southern US to Leeds, UK.
    </IntroHeading>

    <ImageBand src="/images/bird1.webp" alt="Chainstitch Bird Design" />

    <TextImageSplit
        imageSrc="/images/bespoke-jacket.webp"
        imageAlt="An embroidered jacket in progress"
    >
        Learn about chainstitch embroidery and the process used to make fully
        custom garments and accessories.
        <a class="btn" href="/about" slot="cta">Learn More</a>
    </TextImageSplit>

    <CtaBanner backgroundImage="/images/bespoke-jacket.webp" heading="Bespoke">
        From full western wear suits to your own design on a denim jacket, get
        the garment of your dreams.
        <a class="btn" href="/bespoke" slot="cta">Start Here</a>
    </CtaBanner>
</Layout>
